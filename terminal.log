apiVersion: apps/v1
kind: Deployment
metadata:
  name: mlflow-test
  namespace: mlflow-test2
  labels:
    helm.sh/chart: mlflow-1.8.0
    app: mlflow
    app.kubernetes.io/name: mlflow
    app.kubernetes.io/instance: mlflow-test
    version: "3.6.0"
    app.kubernetes.io/version: "3.6.0"
    app.kubernetes.io/managed-by: Helm
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 100%
  selector:
    matchLabels:
      app: mlflow
      app.kubernetes.io/name: mlflow
      app.kubernetes.io/instance: mlflow-test
  template:
    metadata:
      labels:
        app: mlflow
        app.kubernetes.io/name: mlflow
        app.kubernetes.io/instance: mlflow-test
    spec:
      serviceAccountName: mlflow-test
      securityContext:
        fsGroup: 1001
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: mlflow
          image: "burakince/mlflow:3.6.0"
          imagePullPolicy: IfNotPresent
          command:
            - mlflow
          args:
            - server
            - --host=0.0.0.0
            - --port=5000
            - --backend-store-uri=sqlite:////data/mlflow.db
            - --default-artifact-root=/data/mlruns
          ports:
            - name: http
              containerPort: 5000
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /health
              port: http
          readinessProbe:
            httpGet:
              path: /health
              port: http
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            privileged: false
            readOnlyRootFilesystem: false
            runAsGroup: 1001
            runAsNonRoot: true
            runAsUser: 1001
          volumeMounts:
            - name: mlflow-data
              mountPath: /data
      volumes:
        - name: mlflow-data
          persistentVolumeClaim:
            claimName: mlflow-test-data-pvc
